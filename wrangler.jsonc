{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asset-gate",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/", "/f/*", "/polyhaven/*", "/api/*", "/gen/*"]
  },
  "routes": [{ "pattern": "assets.codepawl.com", "custom_domain": true }],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "kv_namespaces": [{ "binding": "GEN_QUEUE", "id": "e2687b8ac14845788d8e2a2d90c74149" }],
  "observability": { "enabled": true }
}
